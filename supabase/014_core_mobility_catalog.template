-- Add abs (Mage) and mobility (Rörlighet) exercises to the Strength Hub catalog.
-- Generated by scripts/core-catalog-migration.mjs from src/strength-catalog-core.js; edit those, not the .sql.
-- Only new exercise ids are added. Saved workouts, XP, ranks and baselines are unchanged.
begin;
alter function public.arc_strength_meta(text) rename to arc_strength_meta_v13;
create function public.arc_strength_meta(id text) returns jsonb
language sql immutable set search_path=public,pg_temp as $$
 select coalesce((select value from jsonb_array_elements('__CATALOG__'::jsonb) where value->>'id'=id), public.arc_strength_meta_v13(id))
$$;
revoke all on function public.arc_strength_meta_v13(text) from public,anon,authenticated;
create or replace function public.training_expansion_ready() returns integer language sql stable as $$select 14$$;
notify pgrst,'reload schema';
commit;
