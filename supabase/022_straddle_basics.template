-- Add the beginner straddle steps ("Straddle från grunden") as skill workouts.
-- They come before the existing Straddle tree for people who only get halfway down.
-- Generated by scripts/straddle-base-migration.mjs from src/skills.js; edit those, not the .sql.
-- Only new exercise ids are added. Saved workouts, XP, ranks, skill levels and baselines are unchanged.
begin;
alter function public.arc_strength_meta(text) rename to arc_strength_meta_v21;
create function public.arc_strength_meta(id text) returns jsonb
language sql immutable set search_path=public,pg_temp as $$
 select coalesce((select value from jsonb_array_elements('__CATALOG__'::jsonb) where value->>'id'=id), public.arc_strength_meta_v21(id))
$$;
revoke all on function public.arc_strength_meta_v21(text) from public,anon,authenticated;
create or replace function public.training_expansion_ready() returns integer language sql stable as $$select 22$$;
notify pgrst,'reload schema';
commit;
