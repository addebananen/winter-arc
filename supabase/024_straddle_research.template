-- Replace the beginner straddle steps ("Straddle från grunden", added in 022) with
-- research-based exercises: frog stretch, adductor slides, straddle good mornings and the elevated pancake.
-- Generated by scripts/straddle-base-migration.mjs from src/skills.js; edit those, not the .sql.
-- Same exercise ids as 022, only their metadata changes. Saved workouts, XP, ranks, skill levels and baselines are unchanged.
begin;
alter function public.arc_strength_meta(text) rename to arc_strength_meta_v23;
create function public.arc_strength_meta(id text) returns jsonb
language sql immutable set search_path=public,pg_temp as $$
 select coalesce((select value from jsonb_array_elements('__CATALOG__'::jsonb) where value->>'id'=id), public.arc_strength_meta_v23(id))
$$;
revoke all on function public.arc_strength_meta_v23(text) from public,anon,authenticated;
create or replace function public.training_expansion_ready() returns integer language sql stable as $$select 24$$;
notify pgrst,'reload schema';
commit;
