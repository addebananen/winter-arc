-- Add skill progression exercises. Previously reached baseline levels are preserved.
begin;
create or replace function public.arc_strength_meta(id text) returns jsonb language sql immutable set search_path=public,pg_temp as $$select value from jsonb_array_elements('__CATALOG__'::jsonb) where value->>'id'=$1 limit 1$$;
alter function public.arc_validate_strength(jsonb,jsonb,text) rename to arc_validate_strength_v9;
create function public.arc_validate_strength(p jsonb,old jsonb,day text) returns void
language plpgsql stable set search_path=public,pg_temp as $$
declare w jsonb;e jsonb;v jsonb;m jsonb;seen text[]='{}';key text;
begin
 perform public.arc_validate_strength_v9(p,old,day);
 if coalesce(nullif(p->'skills','null'::jsonb),'{}'::jsonb) is distinct from coalesce(nullif(old->'skills','null'::jsonb),'{}'::jsonb) then raise exception 'Skill-nivåer låses upp av sparade workouts. Tidigare nivåer är låsta som utgångsläge.';end if;
 for w in select value from jsonb_array_elements(coalesce(p#>'{strength,sessions}','[]')) union all select p#>'{strength,active}' where p#>>'{strength,active,id}' is not null loop
  if w->>'date'<>day then continue;end if;
  for e in select value from jsonb_array_elements(w->'exercises') loop
   m=public.arc_strength_meta(e->>'id');
   key=coalesce(m->>'skillAnim',case e->>'id' when 'pushup' then 'push-up' when 'pullup' then 'pull-up' when 'dip' then 'dip' when 'plank' then 'plank' when 'hang' then 'dead-hang' when 'diamond' then 'diamond-push-up' else null end);
   if key is not null then if key=any(seen) then raise exception 'Samma skill-variant räknas en gång per dag. Lägg till set i samma övning.';end if;seen=array_append(seen,key);end if;
   if m ? 'skillTree' then
    for v in select value from jsonb_array_elements(e->'sets') loop
     if v->>'done'='true' and v->'quality' is distinct from 'true'::jsonb then raise exception 'Bekräfta teknik, tempo och båda sidor för dina skill-set.';end if;
    end loop;
   end if;
  end loop;
 end loop;
end;$$;
revoke all on function public.arc_validate_strength_v9(jsonb,jsonb,text),public.arc_validate_strength(jsonb,jsonb,text) from public,anon,authenticated;
create or replace function public.training_expansion_ready() returns integer language sql stable as $$select 10$$;
notify pgrst,'reload schema';
commit;
